# FUA Entertainment System - Configuration
# Copy this file to .env and customize the values for your setup

# ============================================================================
# MEDIA LIBRARY
# ============================================================================
# Semicolon-separated list of root folders containing your media files
MEDIA_FOLDERS=D:\Movies;E:\TV Shows;F:\Anime

# ============================================================================
# TRANSCODING
# ============================================================================
# Device for transcoding: "gpu" (NVIDIA NVENC) or "cpu" (software encoding)
# GPU is much faster but requires NVIDIA GPU with NVENC support
TRANSCODING_DEVICE=gpu

# Video bitrate in kbps (higher = better quality, larger file)
VIDEO_BITRATE=2500

# Audio bitrate in kbps
AUDIO_BITRATE=192

# Video resolution: "original", "1080p", "720p", "480p"
VIDEO_RESOLUTION=original

# FFmpeg encoding preset (ultrafast to veryslow)
# faster = lower quality, slower = higher quality
FFMPEG_PRESET=veryfast

# ============================================================================
# HLS STREAMING
# ============================================================================
# HLS segment duration in seconds (length of each .ts file)
HLS_SEGMENT_DURATION=4

# Number of segments in playlist
HLS_PLAYLIST_SIZE=5

# How often to check for inactive streams (seconds)
# Default: 1800 (30 minutes)
HLS_CLEANUP_INTERVAL=1800

# Remove streams inactive for this long (seconds)
# Default: 14400 (4 hours)
HLS_INACTIVE_TIMEOUT=14400

# Consider stream active if accessed within this time (seconds)
# Default: 300 (5 minutes)
HLS_ACTIVE_THRESHOLD=300

# Directory for HLS temporary files
HLS_TEMP_DIR=temp_hls

# ============================================================================
# SUBTITLES (OpenSubtitles.com API)
# ============================================================================
# OpenSubtitles.com API Key (REQUIRED)
# Register at: https://www.opensubtitles.com/en/users/newuser
# Get API key at: https://www.opensubtitles.com/en/consumers
# Free tier: 200 downloads/day, 40 searches/day
OPENSUBTITLES_API_KEY=YOUR_API_KEY_HERE

# Optional: Your OpenSubtitles username (improves rate limits if logged in)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# User Agent (required by OpenSubtitles API)
OPENSUBTITLES_USER_AGENT=FUA_Entertainment_System v1.0.0

# Subtitle search timeout in seconds
SUBTITLE_SEARCH_TIMEOUT=30

# Enable hash-based search (more accurate but slower): "true" or "false"
SUBTITLE_HASH_SEARCH=true

# Maximum number of subtitle results to return
SUBTITLE_MAX_RESULTS=20

# ============================================================================
# PLAYER
# ============================================================================
# Default playback mode: "auto", "direct", or "hls"
DEFAULT_PLAYBACK_MODE=auto

# Enable seeking in transcoded direct streams (experimental): "true" or "false"
DIRECT_TRANSCODE_SEEK=false

# ============================================================================
# SERVER
# ============================================================================
# Flask secret key (generate a random string for production)
# SECRET_KEY=your-secret-key-here

# Server host (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# Server port
PORT=5000

# Debug mode (DO NOT enable in production!): "true" or "false"
DEBUG=false

# Auto-reload on code changes: "true" or "false"
AUTO_RELOAD=true

# ============================================================================
# LOGGING
# ============================================================================
# Enable verbose logging: "true" or "false"
VERBOSE_LOGGING=false

# Log file path (leave empty for console only)
# LOG_FILE=logs/app.log

# ============================================================================
# PERFORMANCE
# ============================================================================
# Maximum concurrent HLS streams
MAX_CONCURRENT_STREAMS=10

# Stream buffer size in bytes (1048576 = 1MB)
STREAM_BUFFER_SIZE=1048576

# Enable file caching: "true" or "false"
ENABLE_FILE_CACHE=true

# Cache duration in seconds
FILE_CACHE_DURATION=300
